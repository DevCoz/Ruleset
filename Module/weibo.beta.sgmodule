#!name=微博去广告
#!desc=去除微博广告、推广、挂件、弹窗（JQ Body Rewrite 版，基于 HAR 实测数据）
#!category=BetaModule

# ══════════════════════════════════════════════════
# 广告判定等价逻辑（isAd）
#   .mblogtypename IN("广告","热推")
#   .readtimetype == "adMblog"
#   .promotion.recommend IN("广告","热推")
#   .promotion.type | test("ad")
#   .content_auth_info.content_auth_title IN("广告","热推")
#   .ads_material_info.is_ads == true
#   .is_ad == 1
#
# 清理挂件等价逻辑（removeAvatar）
#   del(.block_card_bg,.buttons,.cardid,.icons,.mblog_buttons,.pic_bg_new,
#       .user.avatargj_id,.user.avatar_extend_info,.user.cardid,.user.icons,.user.mbtype)
#
# 清理信息流推广等价逻辑（removeFeedAd）
#   removeAvatar + del(.common_struct,.comment_summary,.extend_info,.semantic_brand_params)
#   + 对 retweeted_status 执行 removeAvatar
# ══════════════════════════════════════════════════

[Rule]
DOMAIN-SUFFIX,uve.weibo.com,DIRECT,extended-matching
DOMAIN,huodong.weibo.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,biz.weibo.com,REJECT,extended-matching,pre-matching

[Map Local]
^https:\/\/api\.weibo\.cn\/2\/(?:ug\/checkin\/list|push\/daily|push\/info)\b data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/photo\/info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/statuses\/push_info\b data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)\b data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category)\b data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/search\/finder_nav_polling\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/video\/redpacket\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/!\/(?:sug\/list\/finderchange|was\/finder\/searchbarchange)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.weibo\.cn\/2\/video\/tiny_video_info_show\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime\b data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php)\b data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead)\b data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead)\b data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]

# ─────────────────────────────────────────────────────────
# 1. 关注 tab 信息流（container_timeline）
#    HAR 实测：广告以 category=dynamic 出现，数据在 .status 而非 .data
#    同时过滤：未关注博主、快转、精选、tag_struct
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline[?&] del(.loadedInfo.headers?,.common_struct?) | if .items then .items |= map(. as $i | ($i.status? // $i.data? // {}) as $blob | (($blob.mblogtypename? // "") | IN("广告","热推")) or ($blob.readtimetype? == "adMblog") or (($blob.promotion.recommend? // "") | IN("广告","热推")) or (($blob.promotion.type? // "") | (. != null and test("ad"))) or (($blob.content_auth_info.content_auth_title? // "") | IN("广告","热推")) or ($blob.ads_material_info.is_ads? == true) or ($blob.is_ad? == 1) as $isAd | if $isAd then empty elif ($i.category? == "dynamic") then $i | del(.status.action_button_icon_dic?,.status.tag_struct?,.status.common_struct?,.status.comment_summary?,.status.extend_info?,.status.semantic_brand_params?,.status.block_card_bg?,.status.buttons?,.status.cardid?,.status.icons?,.status.mblog_buttons?,.status.pic_bg_new?,.status.user.avatargj_id?,.status.user.avatar_extend_info?,.status.user.cardid?,.status.user.icons?,.status.user.mbtype?) | if (.status.user.following? == false) then empty elif ((.status.title.structs? // null) != null) then empty elif (.status.screen_name_suffix_new? | (type == "array" and length > 3 and .[3].content? == "快转了")) then empty elif (.status.title.text? // "" | test("精选")) then empty else if (.status.user.unfollowing_recom_switch? == 1) then .status.user.unfollowing_recom_switch = 0 else . end end elif ($i.category? == "feed") then $i | del(.data.action_button_icon_dic?,.data.tag_struct?,.data.common_struct?,.data.comment_summary?,.data.extend_info?,.data.semantic_brand_params?,.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?,.data.user.avatargj_id?,.data.user.avatar_extend_info?,.data.user.cardid?,.data.user.icons?,.data.user.mbtype?) | if (.data.user.following? == false) then empty elif ((.data.title.structs? // null) != null) then empty elif (.data.screen_name_suffix_new? | (type == "array" and length > 3 and .[3].content? == "快转了")) then empty elif (.data.title.text? // "" | test("精选")) then empty else if (.data.user.unfollowing_recom_switch? == 1) then .data.user.unfollowing_recom_switch = 0 else . end end elif ($i.category? == "feedBiz") then $i else empty end) else . end

# ─────────────────────────────────────────────────────────
# 2. 推荐 tab / 热门未读（container_timeline_hot / unread_hot_timeline）
#    HAR 实测：items[].category="feed"，广告带 promotion.recommend="热推"
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_timeline_hot|unread_hot_timeline)[?] del(.ad?,.advertises?,.trends?,.headers?) | if .items then .items |= map(. as $i | ($i.data? // {}) as $d | (($d.mblogtypename? // "") | IN("广告","热推")) or ($d.readtimetype? == "adMblog") or (($d.promotion.recommend? // "") | IN("广告","热推")) or (($d.promotion.type? // "") | (. != null and test("ad"))) or (($d.content_auth_info.content_auth_title? // "") | IN("广告","热推")) or ($d.ads_material_info.is_ads? == true) or ($d.is_ad? == 1) as $isAd | if $isAd then empty elif ($i.category? == "feed") then $i | del(.data.common_struct?,.data.comment_summary?,.data.extend_info?,.data.semantic_brand_params?,.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?,.data.user.avatargj_id?,.data.user.avatar_extend_info?,.data.user.cardid?,.data.user.icons?,.data.user.mbtype?) else empty end) else . end | if .statuses then .statuses |= map(. as $s | (($s.mblogtypename? // "") | IN("广告","热推")) or ($s.readtimetype? == "adMblog") or (($s.promotion.type? // "") | (. != null and test("ad"))) as $isAd | if $isAd then empty else $s | del(.common_struct?,.comment_summary?,.extend_info?,.semantic_brand_params?,.block_card_bg?,.buttons?,.cardid?,.icons?,.mblog_buttons?,.pic_bg_new?,.user.avatargj_id?,.user.avatar_extend_info?,.user.cardid?,.user.icons?,.user.mbtype?) end) else . end

# ─────────────────────────────────────────────────────────
# 3. 关注 tab 未读面板（container_timeline_unread）
#    HAR 实测：category=feed，广告字段 readtimetype=adMblog + promotion
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline_unread[?] if .items then .items |= map(. as $i | ($i.data? // {}) as $d | (($d.mblogtypename? // "") | IN("广告","热推")) or ($d.readtimetype? == "adMblog") or (($d.promotion.recommend? // "") | IN("广告","热推")) or (($d.promotion.type? // "") | (. != null and test("ad"))) or (($d.content_auth_info.content_auth_title? // "") | IN("广告","热推")) or ($d.ads_material_info.is_ads? == true) or ($d.is_ad? == 1) as $isAd | if $isAd then empty elif ($i.category? == "feed") then $i | del(.data.common_struct?,.data.comment_summary?,.data.extend_info?,.data.semantic_brand_params?,.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?,.data.user.avatargj_id?,.data.user.avatar_extend_info?,.data.user.cardid?,.data.user.icons?,.data.user.mbtype?) else $i end) else . end

# ─────────────────────────────────────────────────────────
# 4. 超话信息流（container_timeline_topic）
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline_topic[?] del(.header.data.follow_guide_info?) | if .items then .items |= map(. as $i | if ($i.category? == "feed") then ($i.data? // {}) as $d | (($d.mblogtypename? // "") | IN("广告","热推")) or ($d.readtimetype? == "adMblog") or (($d.promotion.type? // "") | (. != null and test("ad"))) as $isAd | if $isAd then empty else $i | del(.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?,.data.user.avatargj_id?,.data.user.avatar_extend_info?,.data.user.cardid?,.data.user.icons?,.data.user.mbtype?) | if (.data.title.text? // "" | test("新人导师")) then del(.data.title) else . end end elif ($i.category? == "card") then if ([4,197,236,1012] | contains([$i.data.card_type? // -1])) then empty elif ($i.data.card_type? == 22 and ($i.data | has("card_ad_style"))) then empty else $i | if .data.card_type? == 31 then .data.hotwords = [] else . end end elif ($i.category? == "group") then $i | del(.style.topHover?) | if .items then .items |= map(. as $ii | if ($ii.data? | has("itemid")) then if ($ii.data.itemid? | test("mine_topics|tab_search_input|poiRankList")) then $ii | (if .data.itemid? | test("tab_search_input") then (if .data.hotwords? then .data.hotwords = [{"word":"搜索超话"}] else . end) else . end) | del(.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?) else empty end else $ii | del(.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?,.data.common_struct?) | if ([1008,1024] | contains([.data.card_type? // -1])) then empty else . end end) else . end else $i end) else . end

# ─────────────────────────────────────────────────────────
# 5. 微博详情页（container_detail）
#    HAR 实测：pageHeader 中 wboxcard card_type=236 is_ad_card=1 为广告
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail[?] del(.detailInfo.extend.follow_data?,.detailInfo.extend.reward_info?,.detailInfo.status.reward_info?) | if .pageHeader.data.items then .pageHeader.data.items |= map(. as $i | if ($i.category? == "card" and $i.data.is_ad_card? == 1) then empty elif ($i.category? == "card" and $i.data.card_type? == 227) then empty elif ($i.category? == "group" and (($i.items? // []) | length) > 0) then empty elif ($i.category? == "wboxcard" and $i.data.card_type? == 236) then empty elif ($i.category? == "card" and $i.data.itemid? == "top_searching" and $i.data.card_type? == 248) then empty else $i end) else . end

# ─────────────────────────────────────────────────────────
# 6. 新版评论区（container_detail_comment）
#    HAR 实测：items[].category="detail", type="trend"+adType="广告"|"荐读" 为广告
#              每条评论含 comment_bubble 字段需清除
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail_comment[?] if .items then .items |= map(select(.type? != "trend") | if .type? == "comment" then del(.data.comment_bubble?,.data.comment_bullet_screens_message?,.data.hot_icon?,.data.vip_button?,.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?,.data.user.avatargj_id?,.data.user.avatar_extend_info?,.data.user.cardid?,.data.user.icons?,.data.user.mbtype?) else . end) else . end

# ─────────────────────────────────────────────────────────
# 7. 旧版评论区（build_comments）
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments[?&] (if (.datas? // []) | length > 0 then .datas |= map(. as $i | if ($i.data? == null) then $i else ($i.data | ((.mblogtypename? // "") | IN("广告","热推")) or (.readtimetype? == "adMblog") or ((.promotion.recommend? // "") | IN("广告","热推")) or ((.promotion.type? // "") | (. != null and test("ad"))) or ((.content_auth_info.content_auth_title? // "") | IN("广告","热推"))) as $isAd | if $isAd then empty elif ([6,15,41] | contains([$i.type? // 0])) then empty elif ($i | has("adType")) then empty elif ($i.data.user.name? | . == "超话社区" or . == "微博") then empty else $i | del(.data.comment_bubble?,.data.comment_bullet_screens_message?,.data.hot_icon?,.data.vip_button?,.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?,.data.user.avatargj_id?,.data.user.avatar_extend_info?,.data.user.cardid?,.data.user.icons?,.data.user.mbtype?) end end) elif (.root_comments? // []) | length > 0 then .root_comments |= map(. as $r | (($r.mblogtypename? // "") | IN("广告","热推")) or ($r.readtimetype? == "adMblog") or (($r.promotion.type? // "") | (. != null and test("ad"))) as $isAd | if $isAd then empty elif ($r.user.name? | . == "超话社区" or . == "微博视频") then empty else $r | del(.comment_bubble?,.data.comment_bubble?,.data.comment_bullet_screens_message?,.data.hot_icon?,.data.vip_button?,.block_card_bg?,.buttons?,.cardid?,.icons?,.mblog_buttons?,.pic_bg_new?,.user.avatargj_id?,.user.avatar_extend_info?,.user.cardid?,.user.icons?,.user.mbtype?) end) elif (.comments? // []) | length > 0 then .comments |= map(del(.reply_comment.comment_badge?,.user.icons?)) else . end) | del(.rootComment.comment_bubble?) | if .status.page_info.media_info.vote_info? then del(.status.page_info.media_info.vote_info) else . end

# ─────────────────────────────────────────────────────────
# 8. 转发列表（repost_timeline）
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/repost_timeline[?] (if .hot_reposts then .hot_reposts |= map(. as $r | (($r.mblogtypename? // "") | IN("广告","热推")) or ($r.readtimetype? == "adMblog") or (($r.promotion.type? // "") | (. != null and test("ad"))) as $isAd | if $isAd then empty else $r end) else . end) | (if .reposts then .reposts |= map(. as $r | (($r.mblogtypename? // "") | IN("广告","热推")) or ($r.readtimetype? == "adMblog") or (($r.promotion.type? // "") | (. != null and test("ad"))) as $isAd | if $isAd then empty else $r end) else . end)

# ─────────────────────────────────────────────────────────
# 9. 搜索信息流（search/container_timeline）
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/search\/container_timeline[?] del(.loadedInfo?) | if .items then .items |= map(. as $i | if ($i.category? == "feed") then ($i.data? // {}) as $d | (($d.mblogtypename? // "") | IN("广告","热推")) or ($d.readtimetype? == "adMblog") or (($d.promotion.type? // "") | (. != null and test("ad"))) as $isAd | if $isAd then empty else $i | del(.data.common_struct?,.data.comment_summary?,.data.extend_info?,.data.semantic_brand_params?,.data.block_card_bg?,.data.buttons?,.data.cardid?,.data.icons?,.data.mblog_buttons?,.data.pic_bg_new?) end elif ($i.category? == "card") then if ([19,22,118,206,208,217,236,249,261] | contains([$i.data.card_type? // -1])) then empty elif ($i.data.itemid? == "ads_slide") then empty elif ($i.data.cate_id? == "1114") then empty elif ($i.data | has("rank")) then empty else $i end elif ($i.category? == "cell") then $i elif ($i.category? == "group") then if ($i.item_category? == "insert_item") then empty else $i | if .items then .items |= map(. as $ii | if ([118,182,192,217,247,264] | contains([$ii.data.card_type? // -1])) then empty elif ($ii.data.cate_id? == "1114") then empty else $ii | del(.data.common_struct?,.data.comment_summary?,.data.extend_info?,.data.semantic_brand_params?) end) else . end end else empty end) else . end

# ─────────────────────────────────────────────────────────
# 10. 发现页（search/finder）
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/search\/finder[?] del(.channelInfo.moreChannels?,.header.insert_data?) | if .channelInfo.channels then .channelInfo.channels |= map(. as $ch | if (($ch.key? | IN("band_channel","discover_channel","trends_channel"))) then $ch | del(.payload.loadedInfo.searchBarStyleInfo?) | (if .payload.loadedInfo.searchBarContent? then .payload.loadedInfo.searchBarContent = [] else . end) | del(.payload.loadedInfo.headerBack.channelStyleMap?) | if .payload.items then .payload.items |= map(. as $i | if ($i.category? == "feed") then ($i.data? // {}) as $d | (($d.mblogtypename? // "") | IN("广告","热推")) or ($d.readtimetype? == "adMblog") or (($d.promotion.type? // "") | (. != null and test("ad"))) as $isAd | if $isAd then empty else $i | del(.data.common_struct?,.data.comment_summary?,.data.extend_info?,.data.semantic_brand_params?) end elif ($i.category? == "card") then if ([19,22,118,206,208,217,236,249,261] | contains([$i.data.card_type? // -1])) then empty elif ($i.data.itemid? == "ads_slide") then empty elif ($i.data.cate_id? == "1114") then empty elif ($i.data | has("rank")) then empty else $i end elif ($i.category? == "cell") then $i elif ($i.category? == "group") then if ($i.item_category? == "insert_item") then empty else $i | if .items then .items |= map(. as $ii | if ([118,182,192,217,247,264] | contains([$ii.data.card_type? // -1])) then empty elif ($ii.data.cate_id? == "1114") then empty else $ii | del(.data.common_struct?,.data.comment_summary?,.data.extend_info?,.data.semantic_brand_params?) end) else . end end else empty end) else . end else empty end) else . end | if .header.data.items then .header.data.items |= map(. as $i | if ($i.category? == "card") then if ([19,22,118,206,208,217,236,249,261] | contains([$i.data.card_type? // -1])) then empty elif ($i.data | has("rank")) then empty else $i end elif ($i.category? == "group") then $i | if .items then .items |= map(. as $ii | if ([118,182,192,217,247,264] | contains([$ii.data.card_type? // -1])) then empty else $ii end) else . end else $i end) else . end

# ─────────────────────────────────────────────────────────
# 11. 搜索全结果（searchall）
# ─────────────────────────────────────────────────────────
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/searchall[?] del(.header.data.bg_img?,.header.data.background_scheme?,.header.data.background_url?,.loadedInfo.serviceMap.layer?,.footer.data.bg_lottie?,.footer.data.bg_lottie_dark?,.footer.data.discuss_avatars?) | (if .footer.data.menus then .footer.data.menus |= map(select(.pic? // "" | test("\\d+_ai\\.") | not)) else . end) | (if .cards then .cards |= map(. as $card | if (($card.card_group? // []) | length) > 0 then $card | .card_group |= map(. as $g | if ($g.card_type? == 22) then empty elif ($g.card_type? == 42 and $g.title_extra_text? == "广告") then empty elif ($g.card_type? == 3 and (($g.pics? // []) | length) > 0) then empty elif ($g.mblog?) then ($g.mblog | ((.mblogtypename? // "") | IN("广告","热推")) or (.readtimetype? == "adMblog") or ((.promotion.type? // "") | (. != null and test("ad"))) or (.is_ad? == 1)) as $isAd | if $isAd then empty else $g | del(.mblog.title_source?,.mblog.source_tag_struct?,.mblog.extend_info?,.mblog.common_struct?,.mblog.block_card_bg?,.mblog.buttons?,.mblog.cardid?,.mblog.icons?,.mblog.mblog_buttons?,.mblog.pic_bg_new?,.mblog.user.avatargj_id?,.mblog.user.avatar_extend_info?,.mblog.user.cardid?,.mblog.user.icons?,.mblog.user.mbtype?,.mblog.page_info.media_info.vote_info?) end else $g end) elif ($card.mblog?) then ($card.mblog | ((.mblogtypename? // "") | IN("广告","热推")) or (.readtimetype? == "adMblog") or ((.promotion.type? // "") | (. != null and test("ad"))) or (.is_ad? == 1)) as $isAd | if $isAd then empty else $card | del(.mblog.title_source?,.mblog.source_tag_struct?,.mblog.extend_info?,.mblog.common_struct?,.mblog.block_card_bg?,.mblog.buttons?,.mblog.cardid?,.mblog.icons?,.mblog.mblog_buttons?,.mblog.pic_bg_new?,.mblog.user.avatargj_id?,.mblog.user.avatar_extend_info?,.mblog.user.cardid?,.mblog.user.icons?,.mblog.user.mbtype?,.mblog.page_info.media_info.vote_info?) end else $card end) else . end) | (if .items then .items |= map(. as $i | ($i.data? // {}) as $d | (($d.mblogtypename