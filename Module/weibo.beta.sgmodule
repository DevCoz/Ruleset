#!name=Weibo
#!desc=Weibo app removes ad.
#!category=BetaModule

[Script]
// 微博下面的评论
weibo_comment.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_comment.js,type=http-response,pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/comments/build_comments\?
// 微博 推荐 热门/榜单/放映厅… https://api.weibo.cn/2/statuses/unread_hot_timeline?
// 微博 最新微博 https://api.weibo.cn/2/statuses/friends/timeline?
// 视频流（短视频上划，微博继续推荐新视频） https://api.weibo.cn/2/video/tiny_stream_video_list?
// 微博 全部关注 https://api.weibo.cn/2/statuses/unread_friends_timeline?
weibo_statuses.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_statuses.js,type=http-response,pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(statuses/unread_hot_timeline|statuses/friends/timeline|video/tiny_stream_video_list|statuses/unread_friends_timeline)\?
// 发现 搜索 https://api.weibo.cn/2/searchall?
// 超话 帖子/精华/官方 https://api.weibo.cn/2/page?
weibo_cardlist.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_cardlist.js,type=http-response,pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(searchall|page)\?
// 发现 热点（这货特殊，有卡片广告） https://api.weibo.cn/2/cardlist?
weibo_cardlist_discover.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_cardlist_discover.js,type=http-response,pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/cardlist\?
// 每条微博下面 创作者广告共享计划
weibo_statuses_extend.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_statuses_extend.js,type=http-response,pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/statuses/extend\?
// 开屏广告
weibo_sdkad.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_sdkad.js,type=http-response,pattern=^https://sdkapp\.uve\.weibo\.com/interface/sdk/sdkad\.php$
weibo_wbapp_wbpullad.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_wbapp_wbpullad.js,type=http-response,pattern=^https://wbapp\.uve\.weibo.com/wbapplua/wbpullad\.lua\?
// 微博 最新微博 https://api.weibo.cn/2/statuses/container_timeline?
// 发现 https://api.weibo.cn/2/search/container_timeline?
weibo_statuses_items.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_statuses_items.js,type=http-response,pattern=^https://api\.weibo\.cn/2/(statuses|search)/container_timeline\?
// 发现（第一次不走上面的 api） https://api.weibo.cn/2/search/finder?
weibo_search_finder.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_search_finder.js,type=http-response,pattern=^https://api\.weibo\.cn/2/search/finder\?
// 微博 博主详情页中的微博 https://api.weibo.cn/2/profile/container_timeline?
weibo_profile_container_timeline.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_profile_container_timeline.js,type=http-response,pattern=^https://api\.weibo\.cn/2/profile/container_timeline\?
// 视频流广告
weibo_rtime_feedback.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_rtime_feedback.js,type=http-response,pattern=^https://api\.weibo\.cn/2/video/real_time_feedback\?
// 视频流评论广告
weibo_video_comment.js = requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_video_comment.js,type=http-response,pattern=^https://api\.weibo\.cn/2/statuses/container_detail_comment\?
[MITM]
hostname = %APPEND% api.weibo.cn, mapi.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com
