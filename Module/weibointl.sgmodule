#!name = 微博净化规则
#!desc = Weibo JQ Ad-Block。
#!category=BetaModule

[Body Rewrite]
# 1. 评论区广告 - 过滤 type=1 的评论 (weibo_comment.js)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/comments/build_comments\? \
  'if has("datas") then .datas |= map(select(.type != 1)) else . end'

# 2. 信息流广告 (推荐/热门/关注流/视频流) - 过滤含 promotion/promotion_info 的条目 (weibo_statuses.js)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(statuses/(unread_hot_timeline|friends/timeline|unread_friends_timeline)|video/tiny_stream_video_list)\? \
  'if has("statuses") then .statuses |= map(select((.promotion // null) == null and (.promotion_info // null) == null)) else . end | if has("advertises") then .advertises = [] else . end | if has("ad") then .ad = [] else . end | if has("trends") then .trends = [] else . end'

# 3. 普通卡片广告 (搜索/超话) - 过滤 card_type=9 + mblog.promotion.type="ad" (weibo_cardlist.js)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(searchall|page)\? \
  'if has("cards") then .cards |= map(select(.card_type != 9 or (.mblog.promotion.type // null) != "ad")) else . end | if has("items") then .items |= map(select((.data.is_ad // 0) != 1)) else . end'

# 4. 发现页热点卡片广告 - 多层嵌套过滤 (weibo_cardlist_discover.js)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/cardlist\? \
  'if has("cards") then 
    .cards |= map(select(.card_type != 9 or (.mblog.promotion.type // null) != "ad")) |
    .cards |= map(
      if .card_type == 11 and has("card_group") then 
        .card_group |= map(
          if .card_type == 118 and has("items") then 
            .items |= map(select(.card_type != 119 or (.sub_item[0].promotion // null) == null)) |
            .items = (reduce range(0; .items | length) as $i (.; .items[$i].itemid = "window_\($i)"))
          else . end
        )
      else . end
    )
  else . end'

# 5. 博主主页微博流 - 过滤 data.promotion.type="ad" (weibo_profile_container_timeline.js)
http-response-jq ^https://api\.weibo\.cn/2/profile/container_timeline\? \
  'if has("items") then .items |= map(select((.data.promotion.type // null) != "ad")) else . end'

# 6. 容器流广告 (最新微博/发现页) - 过滤 mblogtype=1 + promotion/promotion_info (weibo_statuses_items.js)
http-response-jq ^https://api\.weibo\.cn/2/(statuses|search)/container_timeline\? \
  'if has("items") then 
    .items |= map(select((.data.mblogtype // 0) != 1)) |
    .items |= map(select((.status.promotion // null) == null and (.status.promotion_info // null) == null))
  else . end'

# 7. 搜索发现页 (finder) - 过滤 channelInfo.channels[0].payload.items[].data.promotion.type="ad" (weibo_search_finder.js)
http-response-jq ^https://api\.weibo\.cn/2/search/finder\? \
  'if has("channelInfo") and .channelInfo | has("channels") and (.channelInfo.channels | length) > 0 then 
    .channelInfo.channels[0] |= 
      (if has("payload") and .payload | has("items") then 
        .payload.items |= map(select((.data.promotion.type // null) != "ad"))
       else . end)
  else . end'

# 8. 创作者广告共享计划 - 删除 trend + 过滤 head_cards 广告 (weibo_statuses_extend.js)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/statuses/extend\? \
  'if has("trend") then del(.trend) else . end |
  if has("head_cards") then 
    .head_cards |= map(select(
      (.actionlog.source // "") != "ad" and 
      ((.action_button.actionlog.source // "") != "ad") and 
      not(.card_type == 236 and (.is_ad_card // 0) == 1)
    ))
  else . end'

# 9. 视频流反馈广告
http-response-jq ^https://api\.weibo\.cn/2/video/real_time_feedback\? \
  'del(.ad_info, .promotion, .ad_data)'

# 10. 视频评论广告
http-response-jq ^https://api\.weibo\.cn/2/statuses/container_detail_comment\? \
  'if has("root") and (.root | has("comments")) then .root.comments |= map(select(.type != 1)) else . end'

# 11. wbapp 开屏广告 - 修改 cached_ad.ads 时间戳 (weibo_wbapp_wbpullad.js)
http-response-jq ^https://wbapp\.uve\.weibo\.com/wbapplua/wbpullad\.lua\? \
  'if has("cached_ad") and .cached_ad | has("ads") then 
    .cached_ad.ads |= map(.duration = 0 | .end_date = "1796024904" | .start_date = "1796024914")
  else . end'

[Body Rewrite]
# 12. sdkapp 开屏广告 - 返回空广告结构 (weibo_sdkad.js 响应格式为 {json}OK，JQ 无法处理，用兜底方案)
http-response ^https://sdkapp\.uve\.weibo\.com/interface/sdk/sdkad\.php$ json {"background_delay_display_time":31536000,"ads":[]}

[MITM]
hostname = %APPEND% api.weibo.cn, mapi.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com
