#!name = 微博净化规则
#!desc = 微博净化模块 (原生 JQ 版)。
#!category=BetaModule

[Rule]
# --- 高性能预匹配 (手册 Pre-matching 特性) ---
# 对应原脚本中的 sdkad.php 和 wbpullad.lua 路径域名
DOMAIN,sdkapp.uve.weibo.com,REJECT,pre-matching
DOMAIN,wbapp.uve.weibo.com,REJECT,pre-matching
DOMAIN,bootpreload.uve.weibo.com,REJECT,pre-matching
DOMAIN-SUFFIX,biz.weibo.com,REJECT,pre-matching

[Body Rewrite]
# --- 1. 评论区广告处理 ---
# 对应 build_comments 和 container_detail_comment
http-response-jq ^https:\/\/(api\.weibo\.cn|mapi\.weibo\.com)\/2\/(comments\/build_comments|statuses\/container_detail_comment) 'if .datas then .datas |= map(select(.adType? == null)) elif .items then .items |= map(select(.type? != "comment_header_filter")) else . end'

# --- 2. 首页/推荐/关注/视频流 ---
# 对应 unread_hot_timeline, friends/timeline, tiny_stream_video_list 等
http-response-jq ^https:\/\/(api\.weibo\.cn|mapi\.weibo\.com)\/2\/(statuses\/(unread_hot_timeline|friends\/timeline|unread_friends\/timeline|container_timeline)|video\/tiny_stream_video_list) 'def is_ad: (type=="object") and ([.mblogtypename?, .actionlog?.source?] | map(tostring) | any(.=="广告" or .=="ad")); if .items then .items |= map(select(is_ad|not)) elif .statuses then .statuses |= map(select(is_ad|not)) else . end'

# --- 3. 发现/搜索/超话/热点 ---
# 对应 searchall, page, cardlist, search/finder
http-response-jq ^https:\/\/(api\.weibo\.cn|mapi\.weibo\.com)\/2\/(searchall|page|cardlist|search\/finder) 'if .cards then .cards |= map(select(.card_type? != 118)) elif .items then .items |= map(select(.card_type? != 118)) else . end'

# --- 4. 详情页与创作者计划 ---
# 对应 statuses/extend
http-response-jq ^https:\/\/(api\.weibo\.cn|mapi\.weibo\.com)\/2\/statuses\/extend 'del(.top_cards)'

# --- 5. 博主详情页微博 ---
# 对应 profile/container_timeline
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/profile\/container_timeline 'if .items then .items |= map(select(.itemId == "profileme_mine" or .itemId == "100505_-_top8")) else . end'

# --- 6. 视频反馈广告拦截 ---
# 对应 video/real_time_feedback (直接返回空)
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/video\/real_time_feedback '{}'

[MITM]
hostname = %APPEND% api.weibo.cn, mapi.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com
