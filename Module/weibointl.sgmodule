#!name = 微博净化规则
#!desc = Weibo JQ Ad-Block。
#!category=BetaModule

[Body Rewrite]
# 1. 评论区：去除广告元素、推荐趋势、评论内嵌广告
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/comments/build_comments\? 'del(.ad_list[]?, .trends[]?, .root_comments[]?.keyword_ads[]?)'

# 2. 核心信息流：去除推荐流、关注流、视频流中的推广微博 (promotion/ad_state)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(statuses/(unread_hot|friends|unread_friends)_timeline|video/tiny_stream_video_list)\? 'del(.statuses[]? | select(.promotion != null or .ad_state != null)) | del(.advertises[]?, .ad[]?)'

# 3. 发现页与搜索卡片：去除特定的广告卡片类型 (card_type 9且带推广, 118, 122等)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(searchall|page|cardlist)\? 'del(.cards[]? | select(.card_type == 9 and .mblog.promotion != null)) | del(.cards[]? | select(.card_type == 118 or .card_type == 122 or .card_type == 182)) | del(.cards[]? | select(.mblog.ad_state != null))'

# 4. 发现页热点 (特殊处理)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/cardlist\? 'del(.cards[]? | select(.card_type == 9 and .mblog.promotion != null))'

# 5. 微博正文扩展：去除“创作者广告共享计划”、趋势等底部杂项
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/statuses/extend\? 'del(.trend[]?, .f_ads[]?, .cm_ad[]?, .ad_state)'

# 6. 开屏广告：清空广告数组，强制展示时间为0
http-response-jq ^https://sdkapp\.uve\.weibo\.com/interface/sdk/sdkad\.php$ '.ads = [] | .background_delay = 0 | .show_time = 0'
http-response-jq ^https://wbapp\.uve\.weibo\.com/wbapplua/wbpullad\.lua\? '.ad_list = [] | .is_cached = false'

# 7. 容器列表 (搜索/详情页)：去除推广项
http-response-jq ^https://api\.weibo\.cn/2/(statuses|search)/container_timeline\? 'del(.items[]? | select(.data.promotion != null or .data.ad_state != null))'

# 8. 搜索引导页 (Finder)
http-response-jq ^https://api\.weibo\.cn/2/search/finder\? 'del(.channel_list[]?.items[]? | select(.data.promotion != null))'

# 9. 个人主页时间轴
http-response-jq ^https://api\.weibo\.cn/2/profile/container_timeline\? 'del(.items[]? | select(.data.promotion != null))'

# 10. 视频流反馈与评论广告
http-response-jq ^https://api\.weibo\.cn/2/video/real_time_feedback\? 'del(.ad_list[]?)'
http-response-jq ^https://api\.weibo\.cn/2/statuses/container_detail_comment\? 'del(.ad_list[]?, .comment_ad[]?)'

[MITM]
hostname = %APPEND% api.weibo.cn, mapi.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com
