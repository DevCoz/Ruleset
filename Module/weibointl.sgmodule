#!name = 微博净化规则
#!desc = Weibo JQ Ad-Block。
#!category=BetaModule

[Body Rewrite]
# 开屏广告清空（正则替换空响应）
http-response ^https://sdkapp\.uve\.weibo\.com/interface/sdk/sdkad\.php$ json {"status":0,"data":{}}
http-response ^https://wbapp\.uve\.weibo\.com/wbapplua/wbpullad\.lua\? json {"result":0,"data":{}}

[JQ Rewrite]
# 评论区广告过滤（移除 is_ad=true 或 来源为"广告"的评论）
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/comments/build_comments\? \
  '.root.comments |= map(select(.is_ad != true and .source != "广告")) | .root.total_number = (.root.comments | length)'

# 信息流广告（推荐/热门/关注流）— 过滤 mblogtypename="广告"、含 promotion、ad_state=1 的条目
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(statuses/unread_hot_timeline|statuses/friends/timeline|statuses/unread_friends_timeline)\? \
  '.statuses |= map(select(.mblogtypename != "广告" and .ad_state != 1 and (.promotion // null) == null)) | .total_number = (.statuses | length)'

# 短视频流广告过滤
http-response-jq ^https://api\.weibo\.cn/2/video/tiny_stream_video_list\? \
  '.video_list |= map(select(.is_ad != 1 and .ad_info == null))'

# 搜索/超话卡片广告（过滤 card_type 为 ad/promotion 的卡片）
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(searchall|page)\? \
  '.cards |= map(select(.card_type != "ad" and .card_type != "promotion"))'

# 发现页热点卡片广告
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/cardlist\? \
  '.cards |= map(select(.card_group == null or (.card_group | map(select(.itemid != null and (.itemid | contains("ad")) | not)) | length) > 0))'

# 创作者广告共享计划（移除 extend.promotion 字段）
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/statuses/extend\? \
  'del(.extend.promotion)'

# 容器流（最新微博/发现页）
http-response-jq ^https://api\.weibo\.cn/2/(statuses|search)/container_timeline\? \
  '.items |= map(select(.mblogtypename != "广告" and .ad_state != 1))'

# 搜索发现页（finder）
http-response-jq ^https://api\.weibo\.cn/2/search/finder\? \
  '.statuses |= map(select(.mblogtypename != "广告"))'

# 博主主页微博流
http-response-jq ^https://api\.weibo\.cn/2/profile/container_timeline\? \
  '.items |= map(select(.mblogtypename != "广告" and .ad_state != 1))'

# 视频流反馈广告
http-response-jq ^https://api\.weibo\.cn/2/video/real_time_feedback\? \
  'del(.ad_info, .promotion)'

# 视频评论区广告
http-response-jq ^https://api\.weibo\.cn/2/statuses/container_detail_comment\? \
  '.root.comments |= map(select(.is_ad != true))'

[MITM]
hostname = %APPEND% api.weibo.cn, mapi.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com
