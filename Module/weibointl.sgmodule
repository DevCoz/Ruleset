#!name = 微博净化
#!desc = 微博净化模块 (原生 JQ 版)。
#!category=BetaModule

[Rule]
# --- 1. 低开销拒绝 (预匹配) ---
DOMAIN,bootpreload.uve.weibo.com,REJECT
DOMAIN,wbapp.uve.weibo.com,REJECT
DOMAIN,sdkapp.uve.weibo.com,REJECT
DOMAIN,bootrealtime.uve.weibo.com,REJECT
DOMAIN-SUFFIX,biz.weibo.com,REJECT

# --- 3. 原生 JQ 响应重写 ---

# 评论区过滤 (对应 container_detail_comment)
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail_comment 'def str: (. // "") | tostring; def is_jd: (type == "object") and ([.content_auth_info?.content_auth_title?, .content_auth_info_dark?.content_auth_title?, .data?.content_auth_info?.content_auth_title?, .data?.content_auth_info_dark?.content_auth_title?] | map(str) | any(. == "荐读")); def is_ad: (type == "object") and ((.mblogtypename? | str) == "广告" or .ad_object? != null or .is_ad_card? == 1 or .ad_marked? == true or (.actionlog?.source? | str) == "ad" or is_jd); if .items then .items |= map(select(is_ad | not)) else . end'

# 正文详情页 (处理关注推荐与搜热搜)
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail$ 'def str:(.//"")|tostring; def is_remove: (type=="object") and ((.data?.card_type//0)==4 or (.data?.card_type//0)==86 or (.itemid?=="top_searching") or (.hint?=="大家都在搜") or (.mblogtypename?=="广告")); if (.data|type)=="array" then .data |= map(select(is_remove|not)) elif (.data.items|type)=="array" then .data.items |= map(select(is_remove|not)) else . end'

# 搜索流过滤
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/(search\/container_timeline|searchall) 'def is_bad: (type == "object") and ((.mblogtypename? == "广告") or (.source? == "ad") or (.ad_marked? == true)); if .items then .items |= map(select(is_bad | not)) elif .data?.items then .data.items |= map(select(is_bad | not)) else . end'

# 个人中心净化
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/profile\/me 'if .items then .items |= map(select(.itemId == "profileme_mine" or .itemId == "100505_-_top8" or .itemId == "100505_-_profilevisitor") | if .itemId == "profileme_mine" then del(.header.vipView, .header.vipIcon) else . end) else . end'

# 发现页/热点频道净化
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/search\/finder 'def is_ad: (type == "object") and ((.itemid? == "finder_window") or (.mblogtypename? == "广告") or (.ad_marked? == true)); if .channelInfo?.channels then .channelInfo.channels |= map(select(.key == "discover_channel" or .title == "热点")) else . end'

# 杂项清理 (红包与侧边栏)
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/push\/active 'del(.. | .ug_red_paper?)'
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/extend 'del(.top_cards)'

[MITM]
hostname = %APPEND% api.weibo.cn, *.uve.weibo.com, biz.weibo.com
