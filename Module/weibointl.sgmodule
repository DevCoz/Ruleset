#!name = 微博净化
#!desc = 微博净化模块 (原生 JQ 版)。
#!category=BetaModule

[Rule]
# 1. 利用 5.14.0+ 新特性：高性能预匹配拦截
DOMAIN,bootpreload.uve.weibo.com,REJECT,pre-matching
DOMAIN,wbapp.uve.weibo.com,REJECT,pre-matching
DOMAIN,sdkapp.uve.weibo.com,REJECT,pre-matching
DOMAIN,bootrealtime.uve.weibo.com,REJECT,pre-matching
DOMAIN-SUFFIX,biz.weibo.com,REJECT,pre-matching

[Body Rewrite]
# 2. 用 JQ 实现类似 reject-dict 的效果 (直接重写响应为 {})
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/(guest\/cardlist|checkin\/show|cardlist\?|!\/sug\/list\/finderchangemode|live\/media_homelist|!\/was\/finder\/searchbarchange|search\/container_discover\?|profile\/recommend_popusers|client\/version) '{}'

# 3. 核心微博净化 JQ 逻辑
# 详情页与评论：去广告、荐读
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail(_comment)? 'def str:(.//"")|tostring; def is_ad:(type=="object") and ([.content_auth_info?.content_auth_title?, .data?.blog?.content_auth_info?.content_auth_title?] | map(str) | any(. == "荐读" or . == "广告") or (.is_ad_card?==1) or (.ad_marked?==true) or (.actionlog?.source?=="ad")); if .items then .items |= map(select((is_ad|not) and (.type?!="comment_header_filter"))) elif .data?.items then .data.items |= map(select(is_ad|not)) else . end'

# 搜索流与综合搜索
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/(search\/container_timeline|searchall) 'def is_bad:(type=="object") and ((.mblogtypename?=="广告") or (.source?=="ad") or (.ad_marked?==true) or (.category?=="group" and (.data?.desc?=="相关搜索"))); if .items then .items |= map(select(is_bad|not)) elif .data?.items then .data.items |= map(select(is_bad|not)) else . end'

# 个人中心：清理 VIP 视觉与无用项
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/profile\/me 'if .items then .items |= map(select(.itemId == "profileme_mine" or .itemId == "100505_-_top8" or .itemId == "100505_-_profilevisitor") | if .itemId == "profileme_mine" then del(.header.vipView, .header.vipIcon) elif .itemId == "100505_-_profilevisitor" then del(.footer) else . end) else . end'

# 发现页与杂项清理
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/search\/finder 'if .channelInfo?.channels then .channelInfo.channels |= map(select(.key=="discover_channel" or .title=="热点")) else . end'
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/extend 'del(.top_cards)'
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/push\/active 'del(.. | .ug_red_paper?)'

[MITM]
hostname = %APPEND% api.weibo.cn, *.uve.weibo.com, biz.weibo.com
