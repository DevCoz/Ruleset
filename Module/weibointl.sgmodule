#!name = 微博净化规则
#!desc = Weibo JQ Ad-Block。
#!category=BetaModule

[Body Rewrite]
# 1. 评论区：移除广告卡片、趋势话题、评论间的关键词推广
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/comments/build_comments 'del(.ad_list[]?, .trends[]?, .root_comments[]?.keyword_ads[]?)'

# 2. 信息流/热门/榜单/视频流：移除所有带有 promotion 或 ad_state 标记的推广微博
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(statuses/(unread_hot_timeline|friends/timeline|unread_friends_timeline)|video/tiny_stream_video_list) 'del(.statuses[]? | select(.promotion != null or .ad_state != null)) | del(.advertises[]?)'

# 3. 发现页/搜索/超话：移除卡片流中的推广内容 (card_type 122/118 或特定推广 mblog)
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(searchall|page|cardlist) 'del(.cards[]? | select(.card_type == 9 and .mblog.promotion != null)) | del(.cards[]? | select(.card_type == 122 or .card_type == 118 or .card_type == 192))'

# 4. 正文页扩展：移除创作者广告共享计划及相关趋势
http-response-jq ^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/statuses/extend 'del(.trend[]?, .f_ads[]?, .cm_ad[]?)'

# 5. 开屏广告：清空广告数组，并将倒计时和展示时间归零
http-response-jq ^https://sdkapp\.uve\.weibo\.com/interface/sdk/sdkad\.php '.ads = [] | .background_delay = 0 | .show_time = 0'
http-response-jq ^https://wbapp\.uve\.weibo\.com/wbapplua/wbpullad\.lua '.ad_list = [] | .is_cached = false'

# 6. 容器时间轴 (个人主页/详情页)：移除数据流中的推广项
http-response-jq ^https://api\.weibo\.cn/2/(statuses|search|profile)/container_timeline 'del(.items[]? | select(.data.promotion != null or .data.ad_state != null))'

# 7. 搜索发现 (Finder)：移除频道列表中的推广
http-response-jq ^https://api\.weibo\.cn/2/search/finder 'del(.channel_list[]?.items[]? | select(.data.promotion != null))'

# 8. 视频流反馈与评论：移除视频流中的广告反馈和评论区广告
http-response-jq ^https://api\.weibo\.cn/2/video/real_time_feedback 'del(.ad_list[]?)'
http-response-jq ^https://api\.weibo\.cn/2/statuses/container_detail_comment 'del(.ad_list[]?, .comment_ad[]?)'

[MITM]
hostname = %APPEND% api.weibo.cn, mapi.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com
