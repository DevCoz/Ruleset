#!name = 微博净化规则
#!desc = 微博净化模块 (原生 JQ 版)。
#!category=BetaModule

[Rule]
# --- 高性能预匹配拦截 (符合 5.14.0+ 规范) ---
# 在 SYN/DNS 阶段直接拦截，避免广告请求造成的 CPU 浪涌
DOMAIN,bootpreload.uve.weibo.com,REJECT,pre-matching
DOMAIN,wbapp.uve.weibo.com,REJECT,pre-matching
DOMAIN,sdkapp.uve.weibo.com,REJECT,pre-matching
DOMAIN,bootrealtime.uve.weibo.com,REJECT,pre-matching
DOMAIN-SUFFIX,biz.weibo.com,REJECT,pre-matching

[Body Rewrite]
# --- JQ 实现空字典重写 (替代 Surge 不支持的 reject-dict) ---
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/(guest\/cardlist|checkin\/show|cardlist\?|!\/sug\/list\/finderchangemode|live\/media_homelist|!\/was\/finder\/searchbarchange|search\/container_discover\?|profile\/recommend_popusers|client\/version) '{}'

# --- 核心逻辑：正文/评论去广告与荐读 ---
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail(_comment)? 'def str:(.//"")|tostring; def is_ad:(type=="object") and ([.content_auth_info?.content_auth_title?, .data?.blog?.content_auth_info?.content_auth_title?] | map(str) | any(.=="荐读" or .=="广告") or (.is_ad_card?==1) or (.ad_marked?==true) or (.actionlog?.source?=="ad") or (.hint?=="大家都在搜") or (.itemid?=="top_searching")); if .items then .items |= map(select((is_ad|not) and (.type?!="comment_header_filter"))) elif .data?.items then .data.items |= map(select(is_ad|not)) else . end'

# --- 核心逻辑：搜索与发现流清理 ---
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/(search\/container_timeline|searchall|search\/finder) 'def is_bad:(type=="object") and ((.mblogtypename?=="广告") or (.source?=="ad") or (.ad_marked?==true) or (.itemid?=="finder_window") or (.category?=="group" and (.data?.desc?=="相关搜索"))); if .items then .items |= map(select(is_bad|not)) elif .data?.items then .data.items |= map(select(is_bad|not)) else . end'

# --- 个人中心：精简 UI 元素 ---
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/profile\/(me|container_timeline) 'if .items then .items |= map(select(.itemId == "profileme_mine" or .itemId == "100505_-_top8" or .itemId == "100505_-_profilevisitor") | if .itemId == "profileme_mine" then del(.header.vipView, .header.vipIcon) else . end) else . end'

# --- 杂项：清理红包递归属性与扩展卡片 ---
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/push\/active 'del(.. | .ug_red_paper?)'
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/statuses\/extend 'del(.top_cards)'
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments 'if .datas then .datas |= map(if (.adType?|tostring|contains("荐读")) then del(.adType) else . end) else . end'

[MITM]
hostname = %APPEND% api.weibo.cn, *.uve.weibo.com, biz.weibo.com
