#!name=喜马拉雅去广告
#!desc=使用 Map Local 拦截，Body Rewrite JQ 清洗固定字段。
#!category=BetaModule

[Map Local]
^https://[^/]+/hub/(?:guideWord|hotWord)V\d/ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/discovery-feed/v\d/scene/listen/refresh(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/x-web-activity/signIn/getHomePageSignInInfo/ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/subscribe/v\d/subscribe/tagAlbumList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/track-feed/v\d/chase/recommend/ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/social-web/follow-stream/category/\d+$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/mobile-playpage/playpage/recommendContentV\d/ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/mobile-playpage/playpage/recommend/resource/allocation/ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/firework-portal/v\d+/sync(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/business-sale-promotion-guide-mobile-web/popup/ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/app-skin-service/skin/setting/info/ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/lamia/v1/subscribe/status$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/subscribe/v\d/subscribe/recommend(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/mobile-user/v\d/purchased/recommend/ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https://[^/]+/community/square/v\d/stream(?:\?|$) data-type=base64 data="eyJkYXRhIjp7ImNhcmRzIjpbeyJjb250ZW50Ijp7fSwidHlwZSI6IlJFQ09NTUVORFMifV19LCJyZXQiOjB9" status-code=200 header="Content-Type:application/json; charset=utf-8"

[Body Rewrite]
http-response-jq ^https://[^/]+/football-portal/diff2/batch(?:\?|$) 'del(.json.ad, .json.toc)'
http-response-jq ^https://[^/]+/mobile-playpage/playpage/tabs/v2/ 'del(.data.playpage.resourceMap.defaultResource, .data.playpage.resourceMap.playPageTip)'
http-response-jq ^https://[^/]+/mobile-user/v\d/homePage/ 'del(.data.freeListenV2) | if (.data.serviceModule.entrances | type) == "array" then .data.serviceModule.entrances |= map(select(.name == "全部服务")) else . end'
http-response-jq ^https://[^/]+/discovery-feed/v\d/mix/ 'if (.heData | type) == "array" then .heData |= map(select((((.item.list // []) | any(.bizType == "SceneListenCard"))) | not)) else . end'
http-response-jq ^https://[^/]+/discovery-category/customCategories/ 'if (.categoryList | type) == "array" then .categoryList |= map(if (.itemList | type) == "array" then .itemList |= map(select((((.title // "") | tostring | test("直播|123狂欢节|SVIP"; "i"))) | not)) else . end) else . end | if (.customCategoryList | type) == "array" then .customCategoryList |= map(select((((.title // "") | tostring | test("直播|123狂欢节|SVIP"; "i"))) | not)) else . end'
http-response-jq ^https://[^/]+/nexus-web/v\d/tabs/customTabs(?:\?|$) 'if (.data.feedTabs | type) == "array" then .data.feedTabs |= map(select(.name != "大赛")) else . end'

[MITM]
hostname = %APPEND% gslbali.ximalaya.com, search.ximalaya.com, searchwsa.ximalaya.com, mobile.ximalaya.com, mobilehera.ximalaya.com, mobwsa.ximalaya.com, m.ximalaya.com, mwsa.ximalaya.com, live.ximalaya.com, livewsa.ximalaya.com
