[Script]
Twitch去广告 = type=http-response,pattern=https://usher.ttvnw.net/(api/channel/hls|vod),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Yswag/for-own-use/main/js/twitchAdBlock.js,argument={{{luminous}}},binary-body-mode=0

