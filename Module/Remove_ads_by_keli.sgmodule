#!name=广告过滤器
#!desc=去广告合集&作者：@可莉🅥
#!category=去广告

[Rule]
# 广告联盟放行
URL-REGEX, ^https:\/\/(api-access\.pangolin-sdk-toutiao(\d|-b)?|is\.snssdk)\.com\/api\/ad\/union\/sdk\/get_ads, DIRECT // 放行此条以确保字节跳动去广告脚本的正常执行
URL-REGEX, ^https:\/\/open\.e\.kuaishou\.com\/rest\/e\/v3\/open\/univ$, DIRECT // 放行此条以确保快手联盟去广告脚本的正常执行
URL-REGEX, ^https:\/\/mi\.gdt\.qq\.com\/gdt_mview\.fcg\?, DIRECT // 放行此条以确保腾讯优量汇去广告脚本的正常执行

[Script]
# 字节跳动穿山甲
移除字节跳动广告 = type=http-response, pattern=^https:\/\/(api-access\.pangolin-sdk-toutiao(\d|-b)?|is\.snssdk)\.com\/api\/ad\/union\/sdk\/get_ads, script-path=https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Resource/Script/Remove_ads_by_keli/adsense.js, requires-body=true

# 快手联盟
移除快手联盟广告 = type=http-response, pattern=^https:\/\/open\.e\.kuaishou\.com\/rest\/e\/v3\/open\/univ$, script-path=https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Resource/Script/Remove_ads_by_keli/adsense.js, requires-body=true

# 腾讯优量汇
移除腾讯优量汇广告 = type=http-response, pattern=^https:\/\/mi\.gdt\.qq\.com\/gdt_mview\.fcg\?, script-path=https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Resource/Script/Remove_ads_by_keli/adsense.js, requires-body=true
[MITM]
hostname = %APPEND% api-access.pangolin-sdk-toutiao*.com, is.snssdk.com, sf3-fe-tos.pglstatp-toutiao.com, ether-pack.pangolin-sdk-toutiao.com, lf3-analytics.bytescm.com, mi.gdt.qq.com, open.e.kuaishou.com
