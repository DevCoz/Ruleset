#!name=微博去广告净化
#!desc=去除微博客户端信息流、评论区、开屏及各类推广广告。
#!category=BetaModule

[Map Local]
^https?://(biz|bootpreload|fastimage|adimg|sdkapp|promote|game|ads|alitui|dp\.im|widget|dsp\.edm|tui|ad|datacollection|adpinpai)\.weibo\.(com|cn)/.* data="{}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"
^https?://api\.weibo\.cn/2/(push/active|client/addlog_batch|ad/preload).* data="{}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"
^https?://(sdkapp\.uve\.weibo\.com/interface/sdk/|card\.weibo\.com/article/m/aj/(reward|uvead)).* data="{}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"
^https?://api-cloudim\.api\.weibo\.com/v1/log/.* data="{}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"
^https?://m?api\.weibo\.c(n|om)/\d/(cardlist\?v_f=\d|ad/weibointl\?).* data="{}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"
^https?://m?api\.weibo\.c(n|om)/\d/push/daily.* data="{}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"
^https?://boot(realtime|preload)\.uve\.weibo\.com/v\d/ad/(realtime|preload).* data="{}" data-type=text status-code=200 header="Content-Type:application/json; charset=utf-8"


[Script]
# 1. 响应体净化 (核心去广告逻辑)
# 匹配微博核心 API，交由 JS 脚本进行 JSON 节点剔除。
微博响应净化 = type=http-response, pattern=^https?:\/\/(api\.weibo\.cn|m\.weibo\.cn|weibo\.com|new\.vip\.weibo\.cn|api-cloudim\.api\.weibo\.com)\/, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/DevCoz/Ruleset/refs/heads/Pv/Js/WeiboResponse.js, timeout=60

# 3. 请求重写 (时间线接口替换与 UID 缓存)
# 微博个人主页时间线需要特定的 containerid，此脚本用于拦截并重写 URL。
微博请求重写 = type=http-request, pattern=^https?:\/\/api\.weibo\.cn\/2\/(remind\/unread_count|statuses\/user_timeline), script-path=https://raw.githubusercontent.com/DevCoz/Ruleset/refs/heads/Pv/Js/WeiboRequest.js, requires-body=0

[MITM]
# 必须开启 HTTPS 解密。使用 %APPEND% 避免覆盖您配置文件中已有的 hostname。
hostname = %APPEND% api.weibo.cn, m.weibo.cn, weibo.com, uve.weibo.com, api-cloudim.api.weibo.com, card.weibo.com, weibocdn.com, weibomingzi.com, new.vip.weibo.cn, biz.weibo.com, sdkapp.uve.weibo.com
